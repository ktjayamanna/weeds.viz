    {
      "id": "9r6R0WhKFz3tXa5mxdLNG",
      "type": "text",
      "x": -569,
      "y": 439.5,
      "width": 765.4833374023438,
      "height": 540.0000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1807156972,
      "version": 448,
      "versionNonce": 1093795436,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775616090866,
      "link": null,
      "locked": false,
      "text": "Preemptive\n(OS based guided tasks)\n- Involves multiple threads\n- IO threads go to sleep \n   and drop the GIL, allowing \n   another thread to grab it\n- Use a pool of threads, but only\n  one is active at a time due to GIL\n- OS tells when to switch\n- i.e. Threading",
      "fontSize": 43.20000000000001,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preemptive\n(OS based guided tasks)\n- Involves multiple threads\n- IO threads go to sleep \n   and drop the GIL, allowing \n   another thread to grab it\n- Use a pool of threads, but only\n  one is active at a time due to GIL\n- OS tells when to switch\n- i.e. Threading",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uXVn2U-6vo22jNoSTd4PD",
      "type": "text",
      "x": 249.77000122070308,
      "y": 439,
      "width": 920.3666381835938,
      "height": 270.00000000000006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 87825260,
      "version": 430,
      "versionNonce": 1392553964,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775616096321,
      "link": null,
      "locked": false,
      "text": "Cooperative\n(Self-guided tasks)\n- Single threaded (so GIL does not matter)\n- Tasks decides when to switch\n- i.e. AsyncIO",
      "fontSize": 43.20000000000001,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cooperative\n(Self-guided tasks)\n- Single threaded (so GIL does not matter)\n- Tasks decides when to switch\n- i.e. AsyncIO",
      "autoResize": true,
      "lineHeight": 1.25
    },
